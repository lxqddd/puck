  "dependencies": {
    "@puck/avatar-runtime": "workspace:*",
    "@puck/contract": "workspace:*",
    "@wailsio/runtime": "3.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.8",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  }
}
